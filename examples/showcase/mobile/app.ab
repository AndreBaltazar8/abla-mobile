import "abla/build"
import "../../../src/mobile.ab"
import "../../../src/platform.ab"

fun showcaseItems(itemCount: int): MobileNode {
    val items: array<MobileNode> = []
    var item = 0
    while (item < itemCount) {
        items.append(mobileCard("item-$item", "Item ${item + 1}", [
            mobileText(
                "item-$item-detail",
                "Rendered from an Abla array",
                "body"
            )
        ]))
        item = item + 1
    }
    mobileGroup(items)
}

// This one call captures every application variable. `$mobile` lowers the
// template and its inline actions to an ordinary Abla FnMut state machine;
// Android receives only immutable presentation trees and copied event data.
fun showcaseMobileRun(): int {
    var count = 0
    var name = "Abla"
    var darkTheme = false
    var notifications = true
    var volume = 65
    var section = 0
    var itemCount = 4
    var progress = 20
    var status = "Running entirely from Abla"

    mobileRun($mobile
        <Screen title="Abla Mobile" dark={darkTheme}>
            <Column key="root" padding={20} spacing={14} scroll>
                <Text key="app-title" style="headline">
                    Abla Mobile Showcase
                </Text>
                <Text key="status" style="label">{status}</Text>
                <Row key="sections" spacing={8}>
                    <Chip
                        key="section-controls"
                        selected={section == 0}
                        payload="0"
                        onTap={
                            section = 0;
                            status = "Section navigation handled by Abla"
                        }
                    >Controls</Chip>
                    <Chip
                        key="section-lists"
                        selected={section == 1}
                        payload="1"
                        onTap={
                            section = 1;
                            status = "Section navigation handled by Abla"
                        }
                    >Lists</Chip>
                    <Chip
                        key="section-about"
                        selected={section == 2}
                        payload="2"
                        onTap={
                            section = 2;
                            status = "Section navigation handled by Abla"
                        }
                    >About</Chip>
                </Row>
                <Divider key="top-divider" />

                <If condition={section == 0}>
                    <Card key="counter-card" title="Reactive counter">
                        <Text key="count" style="display">{count}</Text>
                        <Row key="counter-actions" spacing={8}>
                            <Button
                                key="decrement"
                                appearance="outlined"
                                onTap={
                                    count = count - 1;
                                    status = "Counter decremented in Abla"
                                }
                            >−1</Button>
                            <Button
                                key="increment"
                                appearance="filled"
                                onTap={
                                    count = count + 1;
                                    status = "Counter incremented in Abla"
                                }
                            >+1</Button>
                            <Button
                                key="reset"
                                appearance="text"
                                enabled={count != 0}
                                onTap={
                                    count = 0;
                                    status = "Counter reset"
                                }
                            >Reset</Button>
                        </Row>
                    </Card>

                    <Card key="input-card" title="Input and preferences">
                        <TextField
                            key="name"
                            label="Your name"
                            value={name}
                            onChange={
                                name = value;
                                status = "Text input round-tripped through Abla"
                            }
                        />
                        <Text key="greeting">Hello, {name}!</Text>
                        <Switch
                            key="dark-theme"
                            label="Dark theme"
                            checked={darkTheme}
                            onChange={
                                darkTheme = mobilePayloadBool(value);
                                status = if (darkTheme)
                                    "Dark theme enabled"
                                else "Light theme enabled"
                            }
                        />
                        <Checkbox
                            key="notifications"
                            label="Enable notifications"
                            checked={notifications}
                            onChange={
                                notifications = mobilePayloadBool(value);
                                status = if (notifications)
                                    "Notifications enabled"
                                else "Notifications disabled"
                            }
                        />
                        <Slider
                            key="volume"
                            label={"Volume: $volume%"}
                            value={volume}
                            minimum={0}
                            maximum={100}
                            onChange={
                                volume = mobilePayloadInt(value, volume);
                                status = "Slider updated Abla state"
                            }
                        />
                    </Card>

                    <Card key="progress-card" title="Progress">
                        <Progress
                            key="linear-progress"
                            value={progress}
                            maximum={100}
                        />
                        <Row key="progress-actions" spacing={8}>
                            <Button
                                key="advance"
                                onTap={
                                    progress = if (progress >= 100)
                                        0 else progress + 10;
                                    status = "Progress advanced"
                                }
                            >Advance</Button>
                            <Button
                                key="celebrate"
                                appearance="outlined"
                                enabled={progress >= 100}
                                onTap={status = "Abla drove this whole screen!"}
                            >Celebrate</Button>
                        </Row>
                    </Card>
                </If>

                <If condition={section == 1}>
                    <Row key="list-actions" spacing={8}>
                        <Button
                            key="add-item"
                            enabled={itemCount < 20}
                            onTap={
                                itemCount = if (itemCount < 20)
                                    itemCount + 1 else itemCount;
                                status = "Added a keyed item"
                            }
                        >Add item</Button>
                        <Button
                            key="remove-item"
                            appearance="outlined"
                            enabled={itemCount > 0}
                            onTap={
                                itemCount = if (itemCount > 0)
                                    itemCount - 1 else itemCount;
                                status = "Removed a keyed item"
                            }
                        >Remove item</Button>
                    </Row>
                    <Text key="list-count">{itemCount} stable keyed items</Text>
                    <List key="showcase-list">
                        {showcaseItems(itemCount)}
                    </List>
                </If>

                <If condition={section == 2}>
                    <Card key="architecture" title="Everything important is Abla">
                        <Text key="architecture-copy">
                            Counter, text, preferences, progress, navigation and
                            list state are independent Abla variables. Android
                            receives only this immutable presentation tree.
                        </Text>
                        <Text key="platform-copy">
                            These buttons ask Android to act through bounded
                            copied messages.
                        </Text>
                        <Row key="platform-actions" spacing={8}>
                            <Button
                                key="toast"
                                onTap={
                                    mobileToast("Hello from Abla");
                                    status = "Abla requested an Android toast"
                                }
                            >Toast</Button>
                            <Button
                                key="copy"
                                appearance="outlined"
                                onTap={
                                    mobileCopyText("Copied by Abla Mobile");
                                    status = "Abla copied text through Android"
                                }
                            >Copy</Button>
                            <Button
                                key="haptic"
                                appearance="text"
                                onTap={
                                    mobileHaptic();
                                    status = "Abla requested Android haptics"
                                }
                            >Haptic</Button>
                        </Row>
                        <Button
                            key="open-url"
                            appearance="outlined"
                            onTap={
                                mobileOpenUrl(
                                    "https://github.com/AndreBaltazar8/abla"
                                );
                                status = "Abla requested a safe browser intent"
                            }
                        >Open Abla on GitHub</Button>
                    </Card>
                    <Progress key="busy-indicator" value={1} maximum={1} circular />
                </If>
                <Spacer key="bottom-space" height={40} />
            </Column>
        </Screen>
    )
}

val showcaseMobileRunExported = #exportFunction(
    "showcaseMobileRun",
    "abla_mobile_run"
)
