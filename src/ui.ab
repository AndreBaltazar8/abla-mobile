fun mobileList(
    key: string,
    children: array<MobileNode>
): MobileNode = MobileNode(
    "list", key, mobileEmptyProperties(), mobileFlattenChildren(children)
)

fun mobileNodeJson(node: MobileNode): Json {
    val children: array<Json> = []
    var index = 0
    while (index < node.children.size) {
        children.append(mobileNodeJson(node.children[index]))
        index = index + 1
    }
    jsonObject(
        ["type", "key", "properties", "children"],
        [jsonString(node.kind), jsonString(node.key), node.properties,
         jsonArray(children)]
    )
}

fun mobileEncodeStyledTree(
    revision: int,
    title: string,
    darkTheme: bool,
    root: MobileNode,
    showTopBar: bool,
    background: string
): string = jsonStringify(jsonObject(
    ["protocol", "revision", "title", "darkTheme", "showTopBar", "background", "root"],
    [jsonInteger(1), jsonInteger(revision), jsonString(title),
     jsonBoolean(darkTheme), jsonBoolean(showTopBar), jsonString(background),
     mobileNodeJson(root)]
))

fun mobileEncodeTree(
    revision: int,
    title: string,
    darkTheme: bool,
    root: MobileNode
): string = mobileEncodeStyledTree(
    revision, title, darkTheme, root, true, ""
)
