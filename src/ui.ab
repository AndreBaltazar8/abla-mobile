import "abla/json"

// Platform-neutral presentation nodes. Application state is never stored here;
// a fresh tree is constructed from current Abla values for each revision.
class MobileNode(
    val kind: string,
    val key: string,
    val properties: Json,
    val children: array<MobileNode>
)

fun mobileProperties(keys: array<string>, values: array<Json>): Json =
    jsonObject(keys, values)

fun mobileEmptyProperties(): Json = jsonObject([], [])

// Groups let a dynamic template child contribute zero or many nodes. They are
// flattened by containers and never cross the host boundary.
fun mobileGroup(children: array<MobileNode>): MobileNode =
    MobileNode("__group", "", mobileEmptyProperties(), children)

fun mobileFlattenChildren(children: array<MobileNode>): array<MobileNode> {
    val flattened: array<MobileNode> = []
    var index = 0
    while (index < children.size) {
        val child = children[index]
        if (child.kind == "__group") {
            val nested = mobileFlattenChildren(child.children)
            var nestedIndex = 0
            while (nestedIndex < nested.size) {
                flattened.append(nested[nestedIndex])
                nestedIndex = nestedIndex + 1
            }
        } else flattened.append(child)
        index = index + 1
    }
    flattened
}

fun mobileColumn(
    key: string,
    padding: int,
    spacing: int,
    scroll: bool,
    children: array<MobileNode>
): MobileNode = MobileNode(
    "column",
    key,
    mobileProperties(
        ["padding", "spacing", "scroll"],
        [jsonInteger(padding), jsonInteger(spacing), jsonBoolean(scroll)]
    ),
    mobileFlattenChildren(children)
)

fun mobileStyledColumn(
    key: string,
