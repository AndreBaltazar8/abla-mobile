import "abla/build"
import "../../src/protocol.ab"

// This proof deliberately owns several unrelated locals. Nothing outside this
// call receives a pointer or handle to them.
fun mobileLoop(): int {
    var count = 0
    var status = "ready"
    var renders = 0
    var running = true

    while (running) {
        renders = renders + 1
        val tree = "{\"revision\":$renders,\"count\":$count,\"status\":\"$status\"}"

        mobilePublishTree(tree)

        val event = mobileWaitEvent()
        val eventRevision = mobileEventRevision()
        val payload = mobileEventPayload()
        if (event == 1 && eventRevision == renders) {
            count = count + 1
            status = payload
        }
        if (event == 0) running = false
    }

    if (count == 2 && status == "lançamento" && renders == 3) 42 else 1
}

val mobileLoopExported = #exportFunction(
    "mobileLoop",
    "abla_mobile_run"
)
