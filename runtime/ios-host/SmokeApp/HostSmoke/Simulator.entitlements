<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <!-- Disposable Simulator fixture identity, not a developer-team identity
         or a device provisioning profile. Never use for a device build. -->
    <key>application-identifier</key><string>org.abla.host-smoke</string>
    <key>keychain-access-groups</key><array><string>org.abla.host-smoke</string></array>
</dict></plist>
